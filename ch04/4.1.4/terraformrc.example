# ~/.terraformrc (Windows: %APPDATA%\terraform.rc)
# 이 파일을 홈 디렉터리에 .terraformrc 이름으로 복사해 사용한다.

# 1) 플러그인 캐시: 한 번 받은 프로바이더를 여러 작업 디렉터리에서 재사용
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"

# 2) 폐쇄망: 미리 받아 둔 프로바이더 미러에서만 설치
#    terraform providers mirror /opt/terraform/providers 로 미러를 만든다.
# provider_installation {
#   filesystem_mirror {
#     path    = "/opt/terraform/providers"
#     include = ["registry.terraform.io/hashicorp/*"]
#   }
#   direct {
#     exclude = ["registry.terraform.io/hashicorp/*"]
#   }
# }
