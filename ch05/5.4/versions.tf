# =============================================================================
# versions.tf — Terraform 실행 환경과 AWS 프로바이더 설정
# -----------------------------------------------------------------------------
# 이 파일은 다음 두 가지를 정의한다.
#   1) terraform 블록   : Terraform CLI 최소 버전, 사용할 프로바이더와 버전 범위
#   2) provider "aws"   : AWS 리소스(VPC, EC2, RDS, ElastiCache, LB 등)를 만드는 프로바이더
#
# backend 블록이 없으므로 State는 이 폴더의 terraform.tfstate(로컬 파일)에 저장된다.
# (원격 S3 백엔드로 환경별 State를 나누는 방법은 5.6·5.7에서 다룬다)
# =============================================================================

terraform {
  # 이 코드를 실행할 수 있는 Terraform CLI 최소 버전
  required_version = ">= 1.6"

  required_providers {
    # AWS 프로바이더 6.x 사용. "~> 6.0"은 6.0 이상 7.0 미만을 뜻한다(메이저 업그레이드 방지).
    # 실제로 설치된 정확한 버전은 .terraform.lock.hcl에 기록된다.
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

# -----------------------------------------------------------------------------
# AWS 프로바이더
# -----------------------------------------------------------------------------
# 자격 증명은 코드에 넣지 않는다. aws configure로 설정한 프로파일이나
# 환경 변수(AWS_ACCESS_KEY_ID 등)를 프로바이더가 자동으로 찾아 쓴다.
provider "aws" {
  # 모든 리소스를 만들 리전(기본값 ap-northeast-2, 서울). variables.tf 참고
  region = var.region

  # default_tags: 이 프로바이더로 만드는 "태그를 지원하는 모든 리소스"에 자동으로 붙는 공통 태그.
  # 각 리소스의 tags와 병합되며, 같은 키가 있으면 리소스 쪽 값이 우선한다.
  default_tags {
    tags = {
      Project   = "ch05-3tier" # 비용·리소스 검색 시 프로젝트 구분용
      ManagedBy = "terraform"  # 콘솔에서 손으로 고치지 말라는 표시
    }
  }
}
