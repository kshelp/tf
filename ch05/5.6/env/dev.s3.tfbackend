# terraform init -reconfigure -backend-config=env/dev.s3.tfbackend -backend-config="bucket=<state 버킷>"
#
# S3 백엔드 부분 구성 파일 (dev 환경). versions.tf의 backend "s3" {} 에 아래 값이 채워진다.
# bucket은 계정마다 이름이 달라 파일에 넣지 않고 init 명령에서 따로 넘긴다(ch05/5.7의 state_bucket 출력).
# -reconfigure: 이전에 초기화한 다른 환경의 백엔드 설정을 무시하고 새로 초기화한다(State 이전 없음).

# 버킷 안에서 이 환경의 State 파일 경로. 환경마다 달라야 State가 섞이지 않는다.
key          = "ch05/5.6/dev/terraform.tfstate"
region       = "ap-northeast-2" # State 버킷이 있는 리전
encrypt      = true             # State 파일을 S3 서버 측 암호화로 저장 (DB 암호 등 민감 정보 포함)
use_lockfile = true             # S3 잠금 파일(.tflock)로 동시 apply 방지 (Terraform 1.10+)
