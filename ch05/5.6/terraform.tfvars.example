# cp terraform.tfvars.example terraform.tfvars
key_name    = "mykey"
admin_cidr  = "203.0.113.10/32" # curl -s https://checkip.amazonaws.com 결과/32
db_password = "rootroot"        # 실습용 RDS 마스터 암호 (8자 이상)

# 비용을 줄이려면
# db_multi_az = false

# GitOps (argocd.tf) — Argo CD가 web·was 앱을 가져올 저장소. gitops/ 디렉터리를 먼저 push해 둔다.
# gitops_repo_url      = "https://github.com/<계정>/<저장소>.git"
# gitops_repo_revision = "main"
# gitops_repo_path     = "ch05/5.6/gitops"
